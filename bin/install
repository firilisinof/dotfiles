#!/bin/bash
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
configs=false
packages=false
dry_run=false
if [ "$#" -eq 0 ]; then configs=true; fi
for arg in "$@"; do
  case "$arg" in
    --config) configs=true ;;
    --packages) packages=true ;;
    --all) configs=true; packages=true ;;
    --dry-run) dry_run=true ;;
    -h|--help)
      echo 'Usage: bin/install [--config] [--packages] [--all] [--dry-run]'
      echo 'Default: link configs. Existing unrelated files are never overwritten.'
      exit 0 ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done
if ! $configs && ! $packages; then configs=true; fi

sources=(
  config/ai/bootstrap.md config/ai/bootstrap.md config/ai/bootstrap.md
  config/ai/bootstrap.md
  config/ai/skills config/ai/skills config/ai/skills config/ai/skills
  config/gh/config.yml config/ghostty/config config/git/config config/git/ignore
  config/ssh/config config/zsh/environment.zsh
  config/zsh/zshenv config/zsh/zprofile config/zsh/zshrc
)
targets=(
  .codex/AGENTS.md .claude/CLAUDE.md .gemini/GEMINI.md
  .omp/agent/AGENTS.md
  .agents/skills .claude/skills .gemini/config/skills .omp/agent/skills
  .config/gh/config.yml .config/ghostty/config .config/git/config .config/git/ignore
  .ssh/config .config/zsh/environment.zsh .zshenv .zprofile .zshrc
)

# Check all destinations before changing anything.
if $configs; then
  for i in "${!sources[@]}"; do
    src="$repo/${sources[$i]}"
    dst="$HOME/${targets[$i]}"
    [ -f "$src" ] || [ -d "$src" ] || { echo "Missing source: $src" >&2; exit 1; }
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then continue; fi
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      echo "Conflict: $dst — move it aside and rerun." >&2
      exit 1
    fi
  done
fi

if $packages; then
  brew=/opt/homebrew/bin/brew
  [ -x "$brew" ] || { echo 'Install Homebrew at https://brew.sh first.' >&2; exit 1; }
  echo "Install packages from Brewfile"
  if ! $dry_run; then "$brew" bundle install --file="$repo/Brewfile" --no-upgrade; fi
fi

if $configs; then
  for i in "${!sources[@]}"; do
    src="$repo/${sources[$i]}"
    dst="$HOME/${targets[$i]}"
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then continue; fi
    echo "$dst -> $src"
    if ! $dry_run; then
      mkdir -p "$(dirname "$dst")"
      ln -s "$src" "$dst"
    fi
  done
  if ! $dry_run; then chmod 700 "$HOME/.ssh"; chmod 600 "$repo/config/ssh/config"; fi
fi
